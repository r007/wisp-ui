{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/storybook-static",
      "!**/coverage",
      "!**/*.generated.*",
      "!**/data/*.json",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": { "cssModules": true },
    "formatter": { "enabled": true, "quoteStyle": "single" }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": "error",
      "correctness": {
        "useExhaustiveDependencies": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useImportExtensions": {
          "level": "error",
          "fix": "none",
          "options": { "forceJsExtensions": true }
        }
      },
      "style": {
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "noNonNullAssertion": "error",
        // The same heuristic, and the same reason, as Stylelint's no-descending-specificity:
        // it cannot see that paired :not() guards make state selectors mutually exclusive.
        "noDescendingSpecificity": "off"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/*/.storybook/**"],
      "linter": { "rules": { "correctness": { "useImportExtensions": "off" } } }
    },
    {
      "includes": ["tools/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useImportExtensions": {
              "level": "error",
              "fix": "none",
              "options": { "forceJsExtensions": false }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.stories.tsx", "**/.storybook/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": { "noNonNullAssertion": "off" },
          "a11y": {
            // Our form controls render a native <input>; tell the rule so a wrapping
            // <label> counts as labelled. Add new input-based components here.
            "noLabelWithoutControl": {
              "level": "error",
              "options": { "inputComponents": ["Switch"] }
            }
          }
        }
      }
    }
  ]
}
