{
  "name": "@wisp-ui/tokens",
  "version": "0.0.0",
  "description": "Design tokens as CSS custom properties, plus a dynamic-colour theme generator and light and dark helpers.",
  "keywords": [
    "design-tokens",
    "css-variables",
    "css-custom-properties",
    "dynamic-color",
    "theming",
    "dark-mode",
    "color-scheme",
    "light-dark"
  ],
  "license": "Apache-2.0",
  "author": "Sergey Monin <moninsergei@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r007/wisp-ui.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node ../../tools/copy-legal.mjs"
  },
  "dependencies": {
    "@material/material-color-utilities": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "lightningcss": "^1.33.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "homepage": "https://r007.github.io/wisp-ui/docs/theming/"
}
