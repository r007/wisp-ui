{
  "name": "wisp-ui-monorepo",
  "private": true,
  "description": "Wisp — Material Design 3 Expressive for the modern web. Lightweight React components, zero-runtime CSS, no shadow DOM.",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check . && stylelint \"packages/**/*.css\"",
    "format": "biome check --write .",
    "codegen": "node tools/codegen/src/cli.ts",
    "storybook": "pnpm --filter @wisp-ui/react storybook",
    "build-storybook": "pnpm --filter @wisp-ui/react build-storybook",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:"
  }
}
